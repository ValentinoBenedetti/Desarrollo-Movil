{
  "name": "tp7-satellite-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "TP7 Satellite Tracker - Propagacion orbital SGP4 en tiempo real, Sky Chart y Validacion Cruzada",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "node --import ./tests/register-ts.mjs tests/orbital.test.ts",
